# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local settings (may contain API keys)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# MCP config (contains Firecrawl API key)
.mcp.json

# scratch / generated experiments
/.scratch/

# duplicate copy of installed skills (.claude/skills is the source; see skills-lock.json)
/.agents/

# keep the env template committable
!.env.example

# third-party skills (reinstall from skills-lock.json)
/.claude/skills/

# reference screenshots from other sites (copyright / size)
/docs/research/refs/

# markdown docs and agent/skill files stay local
*.md
# ...except CLAUDE.md, which is how work runs here (roles, the one-writer rule,
# the review gate) rather than notes about the code. Local-only would mean a
# fresh clone, or anyone else's machine, has none of it.
!/CLAUDE.md
/.claude/
/.agents/
/skills-lock.json
/DESIGN_ORCHESTRATOR.md
# docs/ stays ignored (scratch notes, generated output), but hand-written plans are
# kept — they record decisions and the reasoning behind them, which the code can't.
# book-spa tracks its docs/ in full; this is the narrow equivalent.
/docs/*
!/docs/*.md
!/docs/known-issues/
!/docs/known-issues/*.md
# The absorbed web-zenly marketing docs, and that repo's retired deploy/ops files (Dockerfile,
# nginx, compose, workflows, dev_tools, otp-service). Committed IN FULL rather than just *.md,
# because once web-zenly is archived this is the only copy — the whole point of absorbing it was
# that deleting that repo loses nothing. Non-.md files here are reference material, not build
# inputs: nothing in this repo reads them.
!/docs/marketing/
!/docs/marketing/**
# Supabase email templates live only in the dashboard — not in a migration, not in a restore, and
# set per project by hand. Tracking the source makes them reviewable and re-pasteable; nothing
# loads these files.
!/docs/email-templates/
!/docs/email-templates/*.md
!/docs/email-templates/*.html

# generated by postinstall (scripts/copy-maplibre-worker.mjs)
/public/maplibre/

# mirrored web-zenly static build (scripts/sync-businesses-site.mjs regenerates this).
# DELIBERATELY NOT IGNORED: the build servers have no web-zenly checkout, and the sync
# script hard-fails when neither the source nor an existing mirror is present — which
# broke the first production deploy after /businesses landed. Committing the mirror is
# what lets the existing pipeline build unchanged. Costs ~102MB and a binary diff on each
# marketing refresh; the leaner fix (Actions fetches web-zenly and builds it) is sketched
# on the wip/ghcr-pipeline branch, for when there is a staging environment to rehearse it.

# marketing workspace (Eleventy) — generated build output; the SOURCE in marketing/src is committed
marketing/_site/
marketing/node_modules/
