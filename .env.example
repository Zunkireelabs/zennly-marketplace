# Copy this file to .env and fill in real values. Never commit .env.
# Use a Supabase project made for Zennly, not one shared with another app.

# Supabase Postgres connection strings (Project Settings > Database).
# DATABASE_URL: pooled connection, used by the app at runtime.
# DIRECT_URL: direct connection, used by Prisma for migrations and seeding.
DATABASE_URL=
DIRECT_URL=

# Supabase project settings (Project Settings > API). Needed once login is built.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL, used for the Google sign-in return address. Optional in dev (falls back to the request origin).
NEXT_PUBLIC_SITE_URL=

# Server only. Needed for the delete-account route. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Set to "on" to store activity events in the events table (after the consent decision).
NEXT_PUBLIC_TRACK_EVENTS=
