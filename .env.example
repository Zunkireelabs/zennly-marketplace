# Copy this file to .env and fill in real values. Never commit .env.
# Use a Supabase project made for Zennly, not one shared with another app.

# Supabase Postgres connection strings (Project Settings > Database).
# DATABASE_URL: pooled connection, used by the app at runtime.
# DIRECT_URL: direct connection, used by Prisma for migrations and seeding.
DATABASE_URL=
DIRECT_URL=

# Supabase project settings (Project Settings > API). Needed once login is built.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL, used for the Google sign-in return address (src/app/api/auth/google/route.ts).
# Optional in dev — falls back to the request origin, which is correct on localhost. REQUIRED in
# production: the fallback would use whatever origin the request arrived on, so behind a proxy or
# an alternate hostname Google returns people to the wrong address and sign-in appears to fail.
NEXT_PUBLIC_SITE_URL=

# Server only. Needed for the delete-account route. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Set to "on" to store activity events in the events table (after the consent decision).
NEXT_PUBLIC_TRACK_EVENTS=

# book-spa's marketplace-customer-lookup Edge Function (booking history/membership on a
# connected provider's studio page). Server only — never prefix with NEXT_PUBLIC_, never send
# to the browser; see src/app/api/account/studio-history/route.ts.
# BOOK_SPA_FUNCTIONS_URL is the Edge Functions base, e.g. https://<project-ref>.supabase.co/functions/v1
BOOK_SPA_FUNCTIONS_URL=
BOOK_SPA_MARKETPLACE_SECRET=

# book-spa's own Supabase project, anon key only — the real-booking drawer's read client
# (src/lib/booking/engine-client.ts). Safe to expose to the browser (that's what an anon key is
# for), but kept out of src/lib/supabase/ since it's a different project entirely. See
# docs/booking-migration-plan.md, Phase 1.
NEXT_PUBLIC_BOOK_SPA_ENGINE_URL=
NEXT_PUBLIC_BOOK_SPA_ENGINE_ANON_KEY=

# Default-off kill switch for the real-booking drawer. Set to "on" only once book-spa's
# create-booking endpoint exists — until then this must stay unset/off everywhere, including
# staging, or a customer could believe they've booked when nothing was saved.
NEXT_PUBLIC_ENGINE_BOOKING=

# Optional: point "Book now" at a local book-spa dev server instead of production
# NEXT_PUBLIC_BOOKING_ENGINE_ORIGIN=http://localhost:4028

# Server only. Proxies /book/* (next.config.ts rewrites()) to a local book-spa dev server, so
# the whole booking journey stays on this app's own origin instead of the address bar jumping
# to book-spa's port. Unset/disabled by default — production is untouched. Requires a dev
# server restart (next.config.ts is only read at startup), unlike most env vars here.
# BOOKING_ENGINE_PROXY_TARGET=http://localhost:4028

# Optional: pin the /businesses mirror source to a specific web-zenly checkout.
# Defaults to ../web-zenly — set this when that sibling is on a branch you do not want mirrored.
# WEB_ZENLY_DIR=/tmp/web-zenly-main

# Demo studios (listings with no bookX link) are hidden everywhere unless this is "on".
# Staging sets it to "on"; production leaves it unset.
NEXT_PUBLIC_SHOW_DEMO_STUDIOS=

# Marketing site's "free demo" email-code flow (src/lib/otp-store.ts, src/lib/otp-email.ts),
# ported from otp-service/server.js. Required in production: unlike server.js (which refused to
# start at all without OTP_SECRET), this app can't exit(1) at module load without taking down
# every other route too — so /api/otp/* instead answers 500 server-misconfigured until it's
# set. Without RESEND_API_KEY the code is logged to the server console instead of emailed — the
# documented local-dev behaviour, not a fallback.
OTP_SECRET=
RESEND_API_KEY=
# DEMO_LOGIN_EMAIL=demo@gmail.com
# DEMO_LOGIN_PASSWORD=demo@123
# DEMO_LOGIN_URL=https://dev-app.zennly.io/demo/login
