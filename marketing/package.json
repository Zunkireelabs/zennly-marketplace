{
  "name": "@zennly/marketing",
  "version": "1.0.0",
  "private": true,
  "description": "Zennly marketing site (zennly.io/businesses/*) — Eleventy + Tailwind 3, built into _site/ and mirrored to ../public/businesses by scripts/sync-businesses-site.mjs",
  "scripts": {
    "css:build": "tailwindcss -i ./src/assets/css/main.css -o ./_site/assets/css/tailwind.css",
    "dev": "npm run css:build && concurrently \"eleventy --serve\" \"tailwindcss -i ./src/assets/css/main.css -o ./_site/assets/css/tailwind.css --watch\"",
    "build": "eleventy && tailwindcss -i ./src/assets/css/main.css -o ./_site/assets/css/tailwind.css --minify"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-img": "^6.0.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  },
  "dependencies": {
    "alpinejs": "3.15.12",
    "gsap": "3.15.0",
    "lenis": "1.3.23"
  }
}
